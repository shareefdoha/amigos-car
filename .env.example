# Local development uses embedded PGlite. Production requires a managed database URL.
# Hostinger: mysql://USER:URL_ENCODED_PASSWORD@HOST:3306/DATABASE
# PostgreSQL is also supported: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=
# Set true only when the managed PostgreSQL provider requires TLS and uses a trusted certificate.
DATABASE_SSL=false
PORT=3000
ADMIN_INITIAL_USERNAME=SET_A_PRIVATE_ADMIN_USERNAME
ADMIN_INITIAL_EMAIL=admin@your-company-domain.example
ADMIN_INITIAL_PASSWORD=SET_A_NEW_UNIQUE_PASSWORD_HERE
AUTH_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_BYTES
MAIL_MODE=console
# Set true only for local testing; production always requires MFA.
MFA_DISABLED_FOR_LOCAL_TEST=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Amigos Car Care <no-reply@your-verified-domain.example>"

