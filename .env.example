# Leave DB_* values and DATABASE_URL empty for local embedded PGlite.
# For Hostinger, fill in each MySQL setting separately. DB_PORT defaults to 3306.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false
# Optional legacy connection URL. Complete DB_* settings take precedence.
DATABASE_URL=
DATABASE_SSL=false
PORT=3000
ADMIN_INITIAL_USERNAME=SET_A_PRIVATE_ADMIN_USERNAME
ADMIN_INITIAL_EMAIL=admin@your-company-domain.example
ADMIN_INITIAL_PASSWORD=SET_A_NEW_UNIQUE_PASSWORD_HERE
AUTH_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_BYTES
MAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Amigos Car Care <no-reply@your-verified-domain.example>"


# Direct/legacy booking API email recipient only; the homepage opens branch WhatsApp.
BOOKING_NOTIFICATION_EMAIL=
